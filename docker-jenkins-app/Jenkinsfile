pipeline{
    agent{
        label 'docker-agent'
    }

    stages{
        stage('Verify Agent'){
            steps{
                sh '''
                    echo "Hello from Jenkins CI/CD!"
                    echo "Running on agent: $(hostname)"
                    echo "User: $(whoami)"
                    docker --version
                '''
            }
        }

        stage('Install Test Dependencies'){
            steps{
                dir('docker-jenkins-app'){
                    sh '''
                        python3 -m venv .venv
                        .venv/bin/pip install -r tests/requirements.txt
                    '''
                }
                
            }
        }

        stage('Run API Tests'){
            steps{
                dir('docker-jenkins-app'){
                    sh '''
                    BASE_URL=http://api:8000 .venv/bin/pytest -v tests 
                    '''
                }
            }
        }
        stage('Build Application Images'){
          steps{
            dir('docker-jenkins-app'){
                sh '''
                    GIT_COMMIT_SHORT=$(git rev-parse --short HEAD)
                    docker build -t docker-jenkins-app-api:${GIT_COMMIT_SHORT} ./api
                    docker build -t docker-jenkins-app-worker:${GIT_COMMIT_SHORT} ./worker
                '''
            }
          }
        }

        stage('Push Images to Docker Hub'){
          steps{
            dir('docker-jenkins-app'){
                withCredentials([usernamePassword
                (credentialsId: 'dockerhub-creds' ,
                usernameVariable: 'DOCKERHUB_USER',
                passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sh '''
                        set -eu
                        GIT_COMMIT_SHORT=$(git rev-parse --short HEAD)
                        export DOCKER_CONFIG=$(mktemp -d)
                        trap 'docker logout >/dev/null 2>&1 || true; rm -rf "$DOCKER_CONFIG"' EXIT

                        echo "$DOCKERHUB_TOKEN" | docker login \
                            --username "$DOCKERHUB_USER" \
                            --password-stdin

                        docker tag docker-jenkins-app-api:${GIT_COMMIT_SHORT} \
                            "$DOCKERHUB_USER/ecommerce-api:${GIT_COMMIT_SHORT}"
                        docker tag docker-jenkins-app-worker:${GIT_COMMIT_SHORT} \
                            "$DOCKERHUB_USER/ecommerce-worker:${GIT_COMMIT_SHORT}"

                        docker push "$DOCKERHUB_USER/ecommerce-api:${GIT_COMMIT_SHORT}"
                        docker push "$DOCKERHUB_USER/ecommerce-worker:${GIT_COMMIT_SHORT}"
                    '''
              }
            }
          }
        }
    }   
}