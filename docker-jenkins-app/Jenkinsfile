pipeline{
    agent{
        label 'docker-agent'
    }

    stages{
        stage('Verify Agent'){
            steps{
                sh '''
                    echo "Hello from Jenkins CI/CD!"
                    echo "Running on agent: $(hostname)"
                    echo "User: $(whoami)"
                    docker --version
                '''
            }
        }

        stage('Install Test Dependencies'){
            steps{
                dir('docker-jenkins-app'){
                    sh '''
                        python3 -m venv .venv
                        .venv/bin/pip install -r tests/requirements.txt
                    '''
                }
                
            }
        }

        stage('Run API Tests'){
            steps{
                dir('docker-jenkins-app'){
                    sh '''
                    BASE_URL=http://api:8000 .venv/bin/pytest -v tests 
                    '''
                }
            }
        }
        stage('Build Application Images'){
          steps{
            dir('docker-jenkins-app'){
                sh '''
                    docker compose build api worker
                '''
            }
          }
        }

    }   
}